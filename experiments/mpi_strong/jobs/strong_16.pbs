#!/bin/bash
#PBS -P personal-leyaozhang-nus
#PBS -N mpi_s16
#PBS -l select=1:ncpus=16:mpiprocs=16:ompthreads=1:mem=32gb
#PBS -l walltime=01:00:00
#PBS -j oe
#PBS -o /scratch/leyaozhang-nus/DSA5208_Project3/experiments/mpi_strong/logs/

set -euo pipefail

cd "/scratch/leyaozhang-nus/DSA5208_Project3/experiments/mpi_strong" || exit 1

module load OpenMPI/4.1.4-GCC-11.3.0 || exit 1
export OMP_NUM_THREADS=1

echo "=== Environment ==="
echo "JobID=$PBS_JOBID"
echo "Host=$(hostname)"
echo "MPI_Module=OpenMPI/4.1.4-GCC-11.3.0"
echo "CompilerFlags=-O3 -std=c++17"
echo "Allocated nodes:"
sort "$PBS_NODEFILE" | uniq -c

echo "=== Compile MPI ==="
mpicxx -O3 -std=c++17 "/scratch/leyaozhang-nus/DSA5208_Project3/mpi.cpp" -o "/scratch/leyaozhang-nus/DSA5208_Project3/experiments/mpi_strong/bin/mpi_strong_P16" || exit 1

echo "=== Strong Scaling P=16 ==="

for REP in $(seq 1 3); do

  echo "Starting P=16 Repeat=$REP at $(date -Is)"

  OUT=$(mpirun -np 16 "/scratch/leyaozhang-nus/DSA5208_Project3/experiments/mpi_strong/bin/mpi_strong_P16" 4096 1000) || exit 1

  printf '%s\n' "$OUT" > "/scratch/leyaozhang-nus/DSA5208_Project3/experiments/mpi_strong/results/strong_P16_run${REP}.txt"

  RUNTIME=$(printf '%s\n' "$OUT" | awk -F= '/^Runtime=/{print $2}')
  COMM=$(printf '%s\n' "$OUT" | awk -F= '/^CommunicationTime=/{print $2}')
  COMP=$(printf '%s\n' "$OUT" | awk -F= '/^ComputationTime=/{print $2}')

  if [[ -z "$RUNTIME" || -z "$COMM" || -z "$COMP" ]]; then
    echo "ERROR: Missing timing fields P=16 Repeat=$REP" >&2
    exit 1
  fi

  printf '%s,%s,%s,%s,%s,%s,%s\n'     '16' '4096' '1000'     "$REP" "$RUNTIME" "$COMM" "$COMP"     >> "/scratch/leyaozhang-nus/DSA5208_Project3/experiments/mpi_strong/results/strong_P16.csv"

  echo "Completed P=16 Repeat=$REP Runtime=$RUNTIME"

done

echo "=== Finished ==="
