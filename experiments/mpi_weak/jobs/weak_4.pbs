#!/bin/bash
#PBS -P personal-leyaozhang-nus
#PBS -N mpi_w4
#PBS -l select=1:ncpus=4:mpiprocs=4:ompthreads=1:mem=32gb
#PBS -l walltime=01:00:00
#PBS -j oe
#PBS -o /scratch/leyaozhang-nus/DSA5208_Project3/experiments/mpi_weak/logs/

set -euo pipefail

cd "/scratch/leyaozhang-nus/DSA5208_Project3/experiments/mpi_weak" || exit 1

module load OpenMPI/4.1.4-GCC-11.3.0 || exit 1
export OMP_NUM_THREADS=1

echo "=== Environment ==="
echo "JobID=$PBS_JOBID"
echo "Host=$(hostname)"
echo "MPI_Module=OpenMPI/4.1.4-GCC-11.3.0"
echo "CompilerFlags=-O3 -std=c++17"
echo "Allocated nodes:"
sort "$PBS_NODEFILE" | uniq -c

echo "=== Compile MPI ==="
mpicxx -O3 -std=c++17 "/scratch/leyaozhang-nus/DSA5208_Project3/mpi.cpp" -o "/scratch/leyaozhang-nus/DSA5208_Project3/experiments/mpi_weak/bin/mpi_weak_P4" || exit 1

echo "=== Weak Scaling P=4 N=1024 ==="

for REP in $(seq 1 3); do

  echo "Starting P=4 N=1024 Repeat=$REP at $(date -Is)"

  OUT=$(mpirun -np 4 "/scratch/leyaozhang-nus/DSA5208_Project3/experiments/mpi_weak/bin/mpi_weak_P4" 1024 1000) || exit 1

  printf '%s\n' "$OUT" > "/scratch/leyaozhang-nus/DSA5208_Project3/experiments/mpi_weak/results/weak_P4_run${REP}.txt"

  RUNTIME=$(printf '%s\n' "$OUT" | awk -F= '/^Runtime=/{print $2}')
  COMM=$(printf '%s\n' "$OUT" | awk -F= '/^CommunicationTime=/{print $2}')
  COMP=$(printf '%s\n' "$OUT" | awk -F= '/^ComputationTime=/{print $2}')

  if [[ -z "$RUNTIME" || -z "$COMM" || -z "$COMP" ]]; then
    echo "ERROR: Missing timing fields P=4 Repeat=$REP" >&2
    exit 1
  fi

  printf '%s,%s,%s,%s,%s,%s,%s\n'     '4' '1024' '1000'     "$REP" "$RUNTIME" "$COMM" "$COMP"     >> "/scratch/leyaozhang-nus/DSA5208_Project3/experiments/mpi_weak/results/weak_P4.csv"

  echo "Completed P=4 N=1024 Repeat=$REP Runtime=$RUNTIME"

done

echo "=== Finished ==="
