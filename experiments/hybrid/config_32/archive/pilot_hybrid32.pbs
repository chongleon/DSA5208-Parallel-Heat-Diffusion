
#!/bin/bash
#PBS -P personal-leyaozhang-nus
#PBS -N hybrid32_pilot
#PBS -l select=1:ncpus=32:mpiprocs=4:ompthreads=8:mem=32gb
#PBS -l walltime=00:10:00
#PBS -j oe

set -euo pipefail

cd "$PBS_O_WORKDIR" || exit 1

module load OpenMPI/4.1.4-GCC-11.3.0 || exit 1

export OMP_NUM_THREADS=8
export OMP_DYNAMIC=FALSE
export OMP_PROC_BIND=FALSE

echo "=== Hybrid 32-Core Pilot ==="
echo "Node: $(hostname)"
echo "JobID: $PBS_JOBID"
echo "Allocated nodes:"
sort "$PBS_NODEFILE" | uniq -c

echo "=== Compile Hybrid ==="
mpicxx -O3 -fopenmp -std=c++17 ../../../hybrid.cpp -o hybrid32_pilot

echo "=== CPU Allocation ==="
echo "CPU affinity:"
taskset -pc $$


echo "=== MPI Mapping ==="
date '+%F %T - Before mapping'

timeout 60s mpirun -np 4 --bind-to none hostname

date '+%F %T - After mapping'

# NEW: Check CPU affinity of each MPI Rank
echo "=== Per-Rank CPU Affinity ==="

timeout 60s mpirun -np 4 --bind-to none \
  bash -c 'echo "Rank=$OMPI_COMM_WORLD_RANK"; taskset -pc $$'

echo "=== Hybrid Test ==="

date '+%F %T - Before mpirun'

timeout 180s mpirun -np 4 --bind-to none \
  ./hybrid32_pilot 512 100

date '+%F %T - After mpirun'

echo "=== Finished ==="
