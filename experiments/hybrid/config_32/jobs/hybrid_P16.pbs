#!/bin/bash
#PBS -P personal-leyaozhang-nus
#PBS -N hybrid32_P16
#PBS -l select=1:ncpus=32:mpiprocs=16:ompthreads=2:mem=32gb
#PBS -l walltime=01:00:00
#PBS -j oe
#PBS -o /scratch/leyaozhang-nus/DSA5208_Project3/experiments/hybrid/config_32/logs/

set -euo pipefail

cd "/scratch/leyaozhang-nus/DSA5208_Project3/experiments/hybrid/config_32" || exit 1

module load OpenMPI/4.1.4-GCC-11.3.0 || exit 1

export OMP_NUM_THREADS=2
export OMP_DYNAMIC=FALSE
export OMP_PLACES=cores
export OMP_PROC_BIND=close

echo "=== Environment ==="
echo "JobID=$PBS_JOBID"
echo "Node=$(hostname)"
echo "Ranks=16"
echo "Threads=2"
echo "TotalCores=32"
echo "N=4096"
echo "Steps=1000"
echo "MPI_Module=OpenMPI/4.1.4-GCC-11.3.0"
echo "CompilerFlags=-O3 -fopenmp -std=c++17"

echo "Allocated nodes:"
sort "$PBS_NODEFILE" | uniq -c

echo "CPU affinity:"
taskset -pc $$

echo "=== Compile Hybrid ==="

mpicxx -O3 -fopenmp -std=c++17   "/scratch/leyaozhang-nus/DSA5208_Project3/hybrid.cpp"   -o "/scratch/leyaozhang-nus/DSA5208_Project3/experiments/hybrid/config_32/bin/hybrid_P16"

echo "=== Hybrid P=16 T=2 ==="

for REP in $(seq 1 3); do

  echo "Starting Repeat=$REP at $(date -Is)"

  OUT=$(timeout 300s mpirun -np 16 --bind-to none \
    "/scratch/leyaozhang-nus/DSA5208_Project3/experiments/hybrid/config_32/taskset_rank_launcher.sh" \
    "/scratch/leyaozhang-nus/DSA5208_Project3/experiments/hybrid/config_32/bin/hybrid_P16" 4096 1000) || exit 1

  printf '%s\n' "$OUT" > "/scratch/leyaozhang-nus/DSA5208_Project3/experiments/hybrid/config_32/results/hybrid_P16_run${REP}.txt"

  RUNTIME=$(printf '%s\n' "$OUT" | awk -F= '/^Runtime=/{print $2}')
  COMM=$(printf '%s\n' "$OUT" | awk -F= '/^CommunicationTime=/{print $2}')
  COMP=$(printf '%s\n' "$OUT" | awk -F= '/^ComputationTime=/{print $2}')

  if [[ -z "$RUNTIME" || -z "$COMM" || -z "$COMP" ]]; then
    echo "ERROR: Missing timing fields P=16 Repeat=$REP" >&2
    exit 1
  fi

  printf '%s,%s,%s,%s,%s,%s,%s,%s,%s\n' \
    '16' '2' '32' '4096' '1000' \
    "$REP" "$RUNTIME" "$COMM" "$COMP" \
    >> "/scratch/leyaozhang-nus/DSA5208_Project3/experiments/hybrid/config_32/results/hybrid_P16.csv"

  echo "Completed P=16 Repeat=$REP Runtime=$RUNTIME"

done

echo "=== Finished ==="
