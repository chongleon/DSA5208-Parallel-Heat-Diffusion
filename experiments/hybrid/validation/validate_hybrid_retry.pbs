#!/bin/bash
#PBS -P personal-leyaozhang-nus
#PBS -N hybrid_val_retry
#PBS -l select=1:ncpus=16:mpiprocs=4:ompthreads=4:mem=32gb
#PBS -l walltime=00:08:00
#PBS -j oe

set -euo pipefail

cd "$PBS_O_WORKDIR" || exit 1
module load OpenMPI/4.1.4-GCC-11.3.0 || exit 1

export OMP_NUM_THREADS=4
export OMP_DYNAMIC=FALSE
export OMP_PROC_BIND=FALSE

echo "=== Hybrid Correctness Validation ==="
echo "Node: $(hostname)"
date '+%F %T - Before Hybrid'

timeout 180s mpirun -np 4 --bind-to none \
  ./hybrid_validation 64 100 --validate

date '+%F %T - After Hybrid'

echo "=== Compare with Pure MPI ==="

python3 - <<'PY'
import csv
import math

def read_grid(filename):
    with open(filename, newline="") as f:
        return [[float(x) for x in row] for row in csv.reader(f)]

mpi = read_grid("mpi_result.csv")
hybrid = read_grid("hybrid_result.csv")

N = 64

assert len(mpi) == len(hybrid) == N
assert all(len(row) == N for row in mpi)
assert all(len(row) == N for row in hybrid)

max_error = 0.0

for i in range(N):
    for j in range(N):
        a = mpi[i][j]
        b = hybrid[i][j]

        assert math.isfinite(a) and math.isfinite(b)
        max_error = max(max_error, abs(a - b))

print("Maximum Absolute Error =", max_error)
print("Validation =", "PASS" if max_error < 1e-10 else "FAIL")

if max_error >= 1e-10:
    raise SystemExit(1)
PY

echo "=== Finished ==="