#!/bin/bash
#PBS -P personal-leyaozhang-nus
#PBS -N hybrid_validate
#PBS -l select=1:ncpus=16:mpiprocs=4:ompthreads=4:mem=32gb
#PBS -l walltime=00:15:00
#PBS -j oe

set -euo pipefail

cd "$PBS_O_WORKDIR" || exit 1

module load OpenMPI/4.1.4-GCC-11.3.0 || exit 1

export OMP_NUM_THREADS=4
export OMP_DYNAMIC=FALSE
export OMP_PLACES=cores
export OMP_PROC_BIND=close

echo "=== Environment ==="
hostname
echo "Allocated nodes:"
sort "$PBS_NODEFILE" | uniq -c

echo "=== Compile ==="
mpicxx -O3 -std=c++17 ../../../mpi.cpp -o mpi_validation
mpicxx -O3 -fopenmp -std=c++17 ../../../hybrid.cpp -o hybrid_validation

echo "=== Run Pure MPI ==="
mpirun -np 4 ./mpi_validation 64 100 --validate

echo "=== Run Hybrid ==="
mpirun -np 4 --map-by slot:PE=4 --bind-to core \
  ./hybrid_validation 64 100 --validate

echo "=== Compare Results ==="
python3 - <<'PY'
import csv
import math

def load_grid(path):
    with open(path, newline="") as f:
        return [[float(x) for x in row] for row in csv.reader(f)]

mpi = load_grid("mpi_result.csv")
hybrid = load_grid("hybrid_result.csv")

N = 64
assert len(mpi) == len(hybrid) == N
assert all(len(row) == N for row in mpi)
assert all(len(row) == N for row in hybrid)

max_error = 0.0
for i in range(N):
    for j in range(N):
        a, b = mpi[i][j], hybrid[i][j]
        assert math.isfinite(a) and math.isfinite(b)
        max_error = max(max_error, abs(a - b))

print(f"Maximum Absolute Error = {max_error:.12g}")
print("Validation =", "PASS" if max_error < 1e-10 else "FAIL")

if max_error >= 1e-10:
    raise SystemExit(1)
PY

echo "=== Finished ==="
